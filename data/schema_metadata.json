{
  "database": "MIMIC-IV Clinical Database Demo v2.2",
  "source": "https://physionet.org/content/mimic-iv-demo/2.2/",
  "doi": "10.13026/dp1f-ex47",
  "patient_count": 100,
  "description": "Deidentified hospital and ICU records for 100 patients from Beth Israel Deaconess Medical Center. Dates are shifted. No free-text clinical notes.",
  "modules": {
    "hosp": "Hospital-wide EHR data: admissions, labs, medications, diagnoses, procedures",
    "icu": "ICU-specific data from MetaVision: vitals, inputs/outputs, procedures"
  },
  "tables": [
    {
      "name": "patients",
      "module": "hosp",
      "description": "Core demographics for each patient. One row per patient.",
      "columns": [
        {"name": "subject_id", "type": "INTEGER", "description": "Unique patient identifier", "nullable": false},
        {"name": "gender", "type": "TEXT", "description": "Patient gender: M or F", "nullable": false},
        {"name": "anchor_age", "type": "INTEGER", "description": "Patient age at anchor_year (de-identified reference age)", "nullable": false},
        {"name": "anchor_year", "type": "INTEGER", "description": "De-identified reference year", "nullable": false},
        {"name": "anchor_year_group", "type": "TEXT", "description": "Anchor year range group (e.g. 2011-2013)", "nullable": false},
        {"name": "dod", "type": "TEXT", "description": "Date of death (NULL if alive or unknown)", "nullable": true}
      ],
      "primary_key": "subject_id"
    },
    {
      "name": "admissions",
      "module": "hosp",
      "description": "Hospital admission records. One row per hospital stay.",
      "columns": [
        {"name": "subject_id", "type": "INTEGER", "description": "Patient identifier", "nullable": false},
        {"name": "hadm_id", "type": "INTEGER", "description": "Unique hospital admission identifier", "nullable": false},
        {"name": "admittime", "type": "TEXT", "description": "Admission date and time", "nullable": false},
        {"name": "dischtime", "type": "TEXT", "description": "Discharge date and time", "nullable": false},
        {"name": "deathtime", "type": "TEXT", "description": "Time of in-hospital death (NULL if survived)", "nullable": true},
        {"name": "admission_type", "type": "TEXT", "description": "Type of admission (EMERGENCY, ELECTIVE, etc.)", "nullable": false},
        {"name": "admit_provider_id", "type": "TEXT", "description": "Admitting provider identifier", "nullable": true},
        {"name": "admission_location", "type": "TEXT", "description": "Location prior to admission", "nullable": true},
        {"name": "discharge_location", "type": "TEXT", "description": "Discharge destination", "nullable": true},
        {"name": "insurance", "type": "TEXT", "description": "Insurance type", "nullable": true},
        {"name": "language", "type": "TEXT", "description": "Patient language", "nullable": true},
        {"name": "marital_status", "type": "TEXT", "description": "Marital status", "nullable": true},
        {"name": "race", "type": "TEXT", "description": "Patient race/ethnicity", "nullable": true},
        {"name": "edregtime", "type": "TEXT", "description": "ED registration time", "nullable": true},
        {"name": "edouttime", "type": "TEXT", "description": "ED departure time", "nullable": true},
        {"name": "hospital_expire_flag", "type": "INTEGER", "description": "1 if died during this admission, 0 otherwise", "nullable": false}
      ],
      "primary_key": "hadm_id",
      "foreign_keys": [
        {"column": "subject_id", "references": "patients.subject_id"}
      ]
    },
    {
      "name": "transfers",
      "module": "hosp",
      "description": "Patient physical location changes within the hospital.",
      "columns": [
        {"name": "subject_id", "type": "INTEGER", "description": "Patient identifier", "nullable": false},
        {"name": "hadm_id", "type": "INTEGER", "description": "Hospital admission identifier", "nullable": true},
        {"name": "transfer_id", "type": "INTEGER", "description": "Unique transfer identifier", "nullable": false},
        {"name": "eventtype", "type": "TEXT", "description": "admit, transfer, or discharge", "nullable": false},
        {"name": "careunit", "type": "TEXT", "description": "Care unit name", "nullable": true},
        {"name": "intime", "type": "TEXT", "description": "Time of entry to unit", "nullable": false},
        {"name": "outtime", "type": "TEXT", "description": "Time of exit from unit", "nullable": true}
      ],
      "primary_key": "transfer_id",
      "foreign_keys": [
        {"column": "subject_id", "references": "patients.subject_id"},
        {"column": "hadm_id", "references": "admissions.hadm_id"}
      ]
    },
    {
      "name": "diagnoses_icd",
      "module": "hosp",
      "description": "Billed ICD diagnosis codes for each hospital admission.",
      "columns": [
        {"name": "subject_id", "type": "INTEGER", "description": "Patient identifier", "nullable": false},
        {"name": "hadm_id", "type": "INTEGER", "description": "Hospital admission identifier", "nullable": false},
        {"name": "seq_num", "type": "INTEGER", "description": "Priority sequence for diagnosis", "nullable": false},
        {"name": "icd_code", "type": "TEXT", "description": "ICD diagnosis code (ICD-9 or ICD-10)", "nullable": false},
        {"name": "icd_version", "type": "INTEGER", "description": "ICD version: 9 or 10", "nullable": false}
      ],
      "foreign_keys": [
        {"column": "subject_id", "references": "patients.subject_id"},
        {"column": "hadm_id", "references": "admissions.hadm_id"},
        {"column": "icd_code", "references": "d_icd_diagnoses.icd_code"}
      ]
    },
    {
      "name": "d_icd_diagnoses",
      "module": "hosp",
      "description": "Dictionary of ICD diagnosis codes and their long descriptions.",
      "columns": [
        {"name": "icd_code", "type": "TEXT", "description": "ICD code", "nullable": false},
        {"name": "icd_version", "type": "INTEGER", "description": "ICD version: 9 or 10", "nullable": false},
        {"name": "long_title", "type": "TEXT", "description": "Full text description of the diagnosis", "nullable": false}
      ],
      "primary_key": "icd_code, icd_version"
    },
    {
      "name": "procedures_icd",
      "module": "hosp",
      "description": "Billed ICD procedure codes for each hospital admission.",
      "columns": [
        {"name": "subject_id", "type": "INTEGER", "description": "Patient identifier", "nullable": false},
        {"name": "hadm_id", "type": "INTEGER", "description": "Hospital admission identifier", "nullable": false},
        {"name": "seq_num", "type": "INTEGER", "description": "Priority sequence for procedure", "nullable": false},
        {"name": "icd_code", "type": "TEXT", "description": "ICD procedure code", "nullable": false},
        {"name": "icd_version", "type": "INTEGER", "description": "ICD version: 9 or 10", "nullable": false},
        {"name": "chartdate", "type": "TEXT", "description": "Date procedure was charted", "nullable": false}
      ],
      "foreign_keys": [
        {"column": "subject_id", "references": "patients.subject_id"},
        {"column": "hadm_id", "references": "admissions.hadm_id"},
        {"column": "icd_code", "references": "d_icd_procedures.icd_code"}
      ]
    },
    {
      "name": "d_icd_procedures",
      "module": "hosp",
      "description": "Dictionary of ICD procedure codes and their descriptions.",
      "columns": [
        {"name": "icd_code", "type": "TEXT", "description": "ICD procedure code", "nullable": false},
        {"name": "icd_version", "type": "INTEGER", "description": "ICD version: 9 or 10", "nullable": false},
        {"name": "long_title", "type": "TEXT", "description": "Full text description of the procedure", "nullable": false}
      ],
      "primary_key": "icd_code, icd_version"
    },
    {
      "name": "labevents",
      "module": "hosp",
      "description": "Laboratory test results. High-volume table with one row per lab measurement.",
      "columns": [
        {"name": "labevent_id", "type": "INTEGER", "description": "Unique lab event identifier", "nullable": false},
        {"name": "subject_id", "type": "INTEGER", "description": "Patient identifier", "nullable": false},
        {"name": "hadm_id", "type": "INTEGER", "description": "Hospital admission identifier", "nullable": true},
        {"name": "specimen_id", "type": "INTEGER", "description": "Specimen identifier", "nullable": false},
        {"name": "itemid", "type": "INTEGER", "description": "Lab test identifier (join to d_labitems)", "nullable": false},
        {"name": "charttime", "type": "TEXT", "description": "Time the specimen was charted", "nullable": false},
        {"name": "storetime", "type": "TEXT", "description": "Time the result was stored", "nullable": true},
        {"name": "value", "type": "TEXT", "description": "Lab result value (may be text or numeric)", "nullable": true},
        {"name": "valuenum", "type": "REAL", "description": "Numeric lab result (NULL if non-numeric)", "nullable": true},
        {"name": "valueuom", "type": "TEXT", "description": "Unit of measurement", "nullable": true},
        {"name": "ref_range_lower", "type": "REAL", "description": "Lower reference range", "nullable": true},
        {"name": "ref_range_upper", "type": "REAL", "description": "Upper reference range", "nullable": true},
        {"name": "flag", "type": "TEXT", "description": "Abnormal flag (abnormal, delta, etc.)", "nullable": true},
        {"name": "priority", "type": "TEXT", "description": "Priority of the test", "nullable": true},
        {"name": "comments", "type": "TEXT", "description": "Lab comments", "nullable": true}
      ],
      "primary_key": "labevent_id",
      "foreign_keys": [
        {"column": "subject_id", "references": "patients.subject_id"},
        {"column": "hadm_id", "references": "admissions.hadm_id"},
        {"column": "itemid", "references": "d_labitems.itemid"}
      ]
    },
    {
      "name": "d_labitems",
      "module": "hosp",
      "description": "Dictionary of laboratory test items with labels and categories.",
      "columns": [
        {"name": "itemid", "type": "INTEGER", "description": "Lab test identifier", "nullable": false},
        {"name": "label", "type": "TEXT", "description": "Lab test name", "nullable": false},
        {"name": "fluid", "type": "TEXT", "description": "Specimen fluid type (Blood, Urine, etc.)", "nullable": true},
        {"name": "category", "type": "TEXT", "description": "Lab category (Chemistry, Hematology, etc.)", "nullable": true}
      ],
      "primary_key": "itemid"
    },
