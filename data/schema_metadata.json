    "admissions.hadm_id -> labevents.hadm_id (one admission, many lab results)",
    "admissions.hadm_id -> prescriptions.hadm_id (one admission, many prescriptions)",
    "admissions.hadm_id -> icustays.hadm_id (one admission, potentially multiple ICU stays)",
