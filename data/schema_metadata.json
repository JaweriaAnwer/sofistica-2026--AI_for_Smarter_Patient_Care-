        {"name": "form_rx", "type": "TEXT", "description": "Prescription form", "nullable": true},
        {"name": "dose_val_rx", "type": "TEXT", "description": "Dose value", "nullable": true},
        {"name": "dose_unit_rx", "type": "TEXT", "description": "Dose unit", "nullable": true},
        {"name": "form_val_disp", "type": "TEXT", "description": "Dispensed form value", "nullable": true},
